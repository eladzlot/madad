node_modules/
dist/
dist-landing/
coverage/
test-results/
.playwright/

/*.zip

# Generated PDF fixtures — regenerate with `npm run pdf:fixtures`
tests/fixtures/pdfs/

# Vite dep-optimizer cache (vite-node writes it at the repo root)
.vite/

# Local demo material — mock patient scenarios and the PDFs they generate.
# Never commit these: they are patient-shaped content with no place in git.
demo/scenarios/
demo/out/
demo/notes/

# Remote deployment (branch remote): local secrets and wrangler state
.dev.vars
.wrangler/

# Local environment — credentials and account ids. wrangler reads
# CLOUDFLARE_ACCOUNT_ID from .env so ad-hoc commands hit the trial account; the
# id is not a secret (it is also in package.json), but an env file that gets
# committed is how a real secret leaks later. The committed templates are
# .dev.vars.example (Worker secrets) and, for anything new, add it there too.
.env
.env.*
!.env.example

# Minted pilot material — participant briefs, handouts and the link registry,
# keyed by real email address. Same rule as demo/: personal data, never in git.
minted/
