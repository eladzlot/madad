node_modules/
dist/
dist-landing/
coverage/
test-results/
.playwright/

/*.zip

# Generated PDF fixtures — regenerate with `npm run pdf:fixtures`
tests/fixtures/pdfs/

# Vite dep-optimizer cache (vite-node writes it at the repo root)
.vite/

# Video production media (docs/video/<video>/): footage, renders and music,
# regenerated by each video's build.sh. Only the pipeline, scripts, specs and
# narration are tracked. Plus LibreOffice lock files from the script .docx.
docs/video/*/raw/
docs/video/*/out/
docs/video/*/final/
docs/video/*/music/
docs/video/*/narration/archive/
.~lock.*#

# Local demo material — mock patient scenarios and the PDFs they generate.
# Never commit these: they are patient-shaped content with no place in git.
demo/scenarios/
demo/out/
demo/notes/

# Local environment — credentials and account ids. The committed templates are
# .dev.vars.example (Worker secrets) and, for anything new, add it there too.
.env
.env.*
!.env.example

# Minted pilot material — participant briefs, handouts and the link registry,
# keyed by real email address. Same rule as demo/: personal data, never in git.
minted/
