        "trauma",
        "PTSD",
        "PCL-5",
        "PTCI",
        "assessment",
        "screening"
      ],
      "sequence": [
        {
          "questionnaireId": "pc_ptsd5"
        },
        {
          "type": "if",
          "condition": "score.pc_ptsd5 >= 4",
          "then": [
            {
              "questionnaireId": "pcl5"
            },
            {
              "questionnaireId": "ptci"
            }
          ],
          "else": []
        }
      ]
    }
  ],
  "dependencies": [
