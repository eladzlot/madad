{
  "id": "ecrs",
  "version": "1.0.0",
  "questionnaires": [
    {
      "id": "ecrs",
      "meta": {
        "domains": [
          "attachment"
        ],
        "type": "process",
        "populations": [
          "adult"
        ],
        "source": "Wei, Russell, Mallinckrodt & Vogel (2007), J Personality Assessment 88:187–204 (ECR-S) — wording follows the Hebrew file’s generalised referent rather than the English original"
      },
      "title": "Experiences in Close Relationships — Short Form (ECR-S)",
      "description": "A 12-item measure of attachment anxiety and avoidance. Note: this version generalises the original’s romantic-partner referent to close relationships in general, following the Hebrew file — scores are therefore not directly comparable with published ECR-S norms.",
      "keywords": [
        "attachment",
        "anxiety",
        "avoidance",
        "ECR",
        "ECR-S",
        "relationships"
      ],
      "defaultOptionSetId": "likert7",
      "optionSets": {
        "likert7": [
          {
            "label": "Strongly disagree",
            "value": 1
          },
          {
            "label": "Disagree",
            "value": 2
          },
          {
            "label": "Slightly disagree",
            "value": 3
          },
          {
            "label": "Neutral",
            "value": 4
          },
          {
            "label": "Slightly agree",
            "value": 5
          },
          {
            "label": "Agree",
            "value": 6
          },
          {
            "label": "Strongly agree",
            "value": 7
          }
        ]
      },
      "items": [
        {
          "id": "1",
          "type": "select",
          "text": "It helps to turn to other people in times of need",
          "reverse": true
        },
        {
          "id": "2",
          "type": "select",
          "text": "I need a lot of reassurance that I am loved"
        },
        {
          "id": "3",
          "type": "select",
          "text": "I want to get close to people, but I pull back from them"
        },
        {
          "id": "4",
          "type": "select",
          "text": "I feel that people do not want to be as close as I would like"
        },
        {
          "id": "5",
          "type": "select",
          "text": "I turn to other people for comfort",
          "reverse": true
        },
        {
          "id": "6",
          "type": "select",
          "text": "My desire for closeness pushes people away"
        },
        {
          "id": "7",
          "type": "select",
          "text": "I try to avoid closeness"
        },
        {
          "id": "8",
          "type": "select",
          "text": "I am not worried about being abandoned",
          "reverse": true
        },
        {
          "id": "9",
          "type": "select",
          "text": "I discuss my problems with people close to me",
          "reverse": true
        },
        {
          "id": "10",
          "type": "select",
          "text": "I get frustrated when others are not available"
        },
        {
          "id": "11",
          "type": "select",
          "text": "I become tense when there is too much closeness"
        },
        {
          "id": "12",
          "type": "select",
          "text": "I worry that others do not care about me"
        }
      ],
      "scoring": {
        "method": "subscales",
        "subscales": {
          "anxiety": [
            "2",
            "4",
            "6",
            "8",
            "10",
            "12"
          ],
          "avoidance": [
            "1",
            "3",
            "5",
            "7",
            "9",
            "11"
          ]
        }
      },
      "subscaleLabels": {
        "anxiety": "Attachment anxiety",
        "avoidance": "Attachment avoidance"
      }
    }
  ]
}
