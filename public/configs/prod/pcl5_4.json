        "screening",
        "סינון",
        "גרסה מקוצרת"
      ],
      "defaultOptionSetId": "frequency_5",
      "optionSets": {
        "frequency_5": [
          {
            "label": "כלל לא",
            "value": 0
          },
          {
            "label": "מעט",
            "value": 1
          },
          {
            "label": "במידה בינונית",
            "value": 2
          },
          {
            "label": "במידה רבה",
            "value": 3
          },
          {
            "label": "במידה רבה מאוד",
            "value": 4
          }
        ]
      },
      "items": [
        {
          "id": "intro",
          "type": "instructions",
          "text": "להלן רשימת בעיות שלאנשים יש לפעמים בתגובה לחוויה טראומטית מאוד מלחיצה. קרא/י כל בעיה בעיון ובחר/י את התשובה המתארת עד כמה אותה בעיה הטרידה אותך בשבוע האחרון."
        },
        {
          "id": "1",
          "type": "select",
          "text": "חוויות חוזרות ונשנות, מטרידות ובלתי-רצוניות של החוויה הטראומטית?"
        },
        {
          "id": "7",
          "type": "select",
          "text": "הימנעות מתזכורות חיצוניות של החוויה הטראומטית (אנשים, מקומות, שיחות, פעילויות, חפצים, מצבים)?"
        },
        {
          "id": "9",
          "type": "select",
          "text": "אמונות שליליות חזקות לגבי עצמך, אנשים אחרים, או העולם?"
        },
        {
          "id": "18",
          "type": "select",
          "text": "להיבהל בקלות?"
        }
      ],
      "scoring": {
        "method": "sum"
      },
      "interpretations": {
        "target": "total",
        "type": "screening",
        "ranges": [
          {
            "min": 0,
            "max": 9,
            "label": "מתחת לסף הסינון"
          },
          {
            "min": 10,
            "max": 16,
            "label": "מעל סף הסינון"
          }
        ],
        "cutoffs": [
          {
            "value": 10,
            "label": "סף סינון"
          }
        ]
      },
