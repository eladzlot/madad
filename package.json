{
  "name": "madad",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host --mode development",
    "build:validator": "node scripts/build-validator.mjs",
    "build:catalog": "node scripts/build-catalog.mjs",
    "build": "npm run build:validator && npm run build:catalog && vite build && vite build --config vite.landing.config.js",
    "preview": "vite preview",
    "dev:remote": "npm run build && wrangler d1 migrations apply madad-remote --local && wrangler pages dev dist --port 8788",
    "remote:account": "node -e \"console.log(process.env.CLOUDFLARE_ACCOUNT_ID || '(unset — see scripts/remote/README.md)')\"",
    "deploy:remote": "npm run build && CLOUDFLARE_ACCOUNT_ID=69e0a4dee15d6dd1a9955d86b37bfe6a wrangler pages deploy dist --project-name madad-remote",
    "preview:landing": "vite preview --outDir dist-landing --port 4174 --strictPort --base=/",
    "test": "npm run build:validator && vitest run",
    "test:watch": "vitest",
    "coverage": "vitest run --coverage",
    "e2e": "playwright test",
    "e2e:ui": "playwright test --ui",
    "e2e:dist": "npm run build && playwright test --project=dist-smoke",
    "lint": "eslint src tests scripts composer/src shared aggregate/src clinician help/src server functions",
    "lint:fix": "eslint src tests scripts composer/src shared aggregate/src clinician help/src server functions --fix",
    "validate:configs": "node scripts/validate-configs.mjs",
    "validate:catalog": "node scripts/build-catalog.mjs --check",
    "demo": "vite-node scripts/generate-test-pdfs.mjs --out demo/out",
    "demo:shots": "node scripts/generate-demo-shots.mjs",
    "pdf:fixtures": "vite-node scripts/generate-test-pdfs.mjs",
    "pdf:fixtures:e2e": "vite-node scripts/generate-test-pdfs.mjs tests/fixtures/scenarios/mixed-15-weeks.json --out tests/fixtures/pdfs/mixed15",
    "size": "node scripts/check-size.mjs",
    "build:og": "bash scripts/build-og-image.sh",
    "ci": "npm run lint && npm test && npm run validate:configs && npm run validate:catalog && npm run build && npm run size && npm run e2e"
  },
  "dependencies": {
    "ajv": "^8.18.0",
    "bidi-js": "^1.0.3",
    "fuse.js": "^7.5.0",
    "lit": "^3.3.2",
    "pdfmake": "^0.3.5"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@open-wc/testing": "^4.0.0",
    "@playwright/test": "^1.58.2",
    "@vitest/coverage-v8": "^4.0.18",
    "axe-core": "^4.11.1",
    "eslint": "^10.0.3",
    "eslint-config-prettier": "^10.1.8",
    "globals": "^17.4.0",
    "happy-dom": "^20.8.3",
    "prettier": "^3.8.1",
    "vite": "^7.3.1",
    "vite-node": "^6.0.0",
    "vitest": "^4.0.18",
    "wrangler": "^4.131.2"
  }
}
